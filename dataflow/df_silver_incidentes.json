{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = toShort(AnioFuente),",
				"          IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion),",
				"          VehiculoId = iif(\r",
				"    isNull(VehiculoId),\r",
				"    VehiculoId,\r",
				"    iifNull(trim(VehiculoId), '')\r",
				"),",
				"          FechaHoraInicio = iif(     isTimestamp(FechaHoraInicio, 'dd/MM/yyyy HH:mm'),     toTimestamp(FechaHoraInicio, 'dd/MM/yyyy HH:mm'),     toTimestamp(FechaHoraInicio, 'yyyy-MM-dd HH:mm:ss') ),",
				"          FechaHoraFin = iif(     isTimestamp(FechaHoraFin, 'dd/MM/yyyy HH:mm'),     toTimestamp(FechaHoraFin, 'dd/MM/yyyy HH:mm'),     toTimestamp(FechaHoraFin, 'yyyy-MM-dd HH:mm:ss') ),",
				"          FechaHoraRegistro = iif(     isDate(FechaHoraRegistro, 'dd/MM/yyyy'),     toTimestamp(         concat(FechaHoraRegistro, ' 00:00:00'),         'dd/MM/yyyy HH:mm:ss'     ),     toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss') )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(AnioFuente) && !isNull(IncidenteId) && !isNull(TipoIncidente) && !isNull(Severidad) && !isNull(FechaHoraInicio) && !isNull(FechaHoraFin) && !isNull(FechaHoraRegistro) && !isNull(Descripcion) && FechaHoraInicio <= FechaHoraFin,",
				"     disjoint: false) ~> split1@(incidentesValidos, incidentesNoValidos)",
				"split1@incidentesValidos window(over(AnioFuente,",
				"          IncidenteId),",
				"     desc(FechaHoraInicio, true),",
				"     NumeroFila = rowNumber()) ~> window1",
				"window1 filter(NumeroFila == 1) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}
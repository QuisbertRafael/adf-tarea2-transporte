{
	"name": "df_bronze_demanda_paradas",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_2022_xls",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "bronze_demanda_paradas_2023_xls",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fec_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          abordajes_manuales as string,",
				"          descensos_manuales as string,",
				"          demanda_no_atendida as string,",
				"          medicion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source4",
				"derivedColumn1 select(mapColumn(",
				"          FechaServicio = fec_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = abordajes_manuales,",
				"          Descensos = descensos_manuales,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = medicion,",
				"          AnioFuente,",
				"          DemandaId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn2 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo,",
				"          AnioFuente,",
				"          DemandaId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"derivedColumn3 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          ValidacionesTarjeta = estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo,",
				"          AnioFuente,",
				"          DemandaId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, source2, select2, select3 union(byName: true)~> union1",
				"source1 derive(AnioFuente = toString(year(toDate(fec_servicio, 'dd/MM/yyyy'))),",
				"          DemandaId = concat(     'D-CSV-',     substring(         md5(             toString(fec_servicio),             toString(cod_ruta),             toString(nro_parada),             toString(franja),             toString(abordajes_manuales),             toString(descensos_manuales)         ),         1,         20     ) )) ~> derivedColumn1",
				"source3 derive(AnioFuente = '2022',",
				"          DemandaId = concat(     'D-',     substring(         md5(             toString(fecha_servicio),             toString(cod_ruta),             toString(nro_parada),             toString(franja),             toString(estimacion_abordajes),             toString(estimacion_descensos)         ),         1,         20     ) )) ~> derivedColumn2",
				"source4 derive(AnioFuente = '2023',",
				"          DemandaId = concat(     'D-',     substring(         md5(             toString(fecha_servicio),             toString(cod_ruta),             toString(nro_parada),             toString(franja),             toString(estimacion_abordajes),             toString(estimacion_descensos)         ),         1,         20     ) )) ~> derivedColumn3",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}
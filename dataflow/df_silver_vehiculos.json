{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = toInteger(AnioFuente),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          Estado = upper(trim(Estado)),",
				"          VehiculoId = iif(     startsWith(trim(VehiculoId), 'V-'),     trim(VehiculoId),     concat(         'V-',         lpad(trim(VehiculoId), 3, '0')     ) ),",
				"          VigenciaDesde = iif(     isDate(VigenciaDesde, 'dd/MM/yyyy'),     toDate(VigenciaDesde, 'dd/MM/yyyy'),     toDate(VigenciaDesde, 'yyyy-MM-dd') ),",
				"          VigenciaHasta = iif(     isDate(VigenciaHasta, 'dd/MM/yyyy'),     toDate(VigenciaHasta, 'dd/MM/yyyy'),     toDate(VigenciaHasta, 'yyyy-MM-dd') )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(AnioFuente) && !isNull(VehiculoId) && !isNull(Placa) && !isNull(TipoVehiculo) && !isNull(CapacidadEfectiva) && !isNull(VigenciaDesde) && !isNull(VigenciaHasta) && !isNull(Estado) && CapacidadEfectiva > 0 && VigenciaDesde <= VigenciaHasta,",
				"     disjoint: false) ~> split1@(vehiculosValidos, vehiculosNoValidos)",
				"split1@vehiculosValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}
{
	"name": "df_silver_incidente_ruta",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidente_ruta",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sourceIncidentes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidente_ruta_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceIncidentes",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          EsPrincipal = toBoolean(EsPrincipal),",
				"          AnioFuente = toInteger(AnioFuente)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(AnioFuente) && !isNull(IncidenteId) && !isNull(RutaHistoricaId) && !isNull(EsPrincipal),",
				"     disjoint: false) ~> split1@(relacionesValidas, relacionesNoValidas)",
				"exists1 window(over(AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId),",
				"     desc(EsPrincipal, true),",
				"     NumeroFila = rowNumber()) ~> window1",
				"window1 filter(NumeroFila == 1) ~> filter1",
				"split1@relacionesValidas, sourceIncidentes exists(split1@relacionesValidas@AnioFuente == sourceIncidentes@AnioFuente",
				"     && split1@relacionesValidas@IncidenteId == sourceIncidentes@IncidenteId,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> sink1"
			]
		}
	}
}
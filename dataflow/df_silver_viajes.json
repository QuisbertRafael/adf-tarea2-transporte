{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sourceVehiculos"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sourceRutas"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "existenVehiculos"
				},
				{
					"name": "existenRutas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceVehiculos",
				"source(output(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceRutas",
				"source1 derive(AnioFuente = toInteger(AnioFuente),",
				"          ViajeId = trim(ViajeId),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          EstadoViaje = upper(trim(EstadoViaje)),",
				"          RutaHistoricaId = iif(     startsWith(trim(RutaHistoricaId), 'RH-'),     trim(RutaHistoricaId),     concat(         'RH-',         lpad(             regexReplace(trim(RutaHistoricaId), '[^0-9]', ''),             2,             '0'         )     ) ),",
				"          VehiculoId = iif(     startsWith(trim(VehiculoId), 'V-'),     trim(VehiculoId),     concat(         'V-',         lpad(trim(VehiculoId), 3, '0')     ) ),",
				"          FechaServicio = iif(     isDate(FechaServicio, 'dd/MM/yyyy'),     toDate(FechaServicio, 'dd/MM/yyyy'),     toDate(FechaServicio, 'yyyy-MM-dd') ),",
				"          KmRecorridos = toDecimal(     replace(toString(KmRecorridos), ',', '.'),     8,     1 ),",
				"          HoraProgramada = toTimestamp(     concat('2000-01-01 ', trim(HoraProgramada)),     'yyyy-MM-dd HH:mm' ),",
				"          HoraSalida = toTimestamp(     concat('2000-01-01 ', trim(HoraSalida)),     'yyyy-MM-dd HH:mm' ),",
				"          HoraLlegada = toTimestamp(     concat('2000-01-01 ', trim(HoraLlegada)),     'yyyy-MM-dd HH:mm' )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(AnioFuente) && !isNull(ViajeId) && !isNull(RutaHistoricaId) && !isNull(VehiculoId) && !isNull(FechaServicio) && !isNull(HoraProgramada) && !isNull(HoraSalida) && !isNull(HoraLlegada) && !isNull(ValidacionesTarjeta) && !isNull(KmRecorridos) && !isNull(EstadoViaje) && ValidacionesTarjeta >= 0 && KmRecorridos >= 0,",
				"     disjoint: false) ~> split1@(viajesValidos, viajesNoValidos)",
				"split1@viajesValidos window(over(AnioFuente,",
				"          ViajeId),",
				"     desc(FechaServicio, true),",
				"     NumeroFila = rowNumber()) ~> window1",
				"window1 filter(NumeroFila == 1) ~> filter1",
				"filter1, sourceVehiculos exists(split1@viajesValidos@AnioFuente == sourceVehiculos@AnioFuente",
				"     && split1@viajesValidos@VehiculoId == sourceVehiculos@VehiculoId,",
				"     negate:false,",
				"     broadcast: 'auto')~> existenVehiculos",
				"existenVehiculos, sourceRutas exists(split1@viajesValidos@AnioFuente == sourceRutas@AnioFuente",
				"     && split1@viajesValidos@RutaHistoricaId == sourceRutas@RutaHistoricaId,",
				"     negate:false,",
				"     broadcast: 'auto')~> existenRutas",
				"existenRutas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}
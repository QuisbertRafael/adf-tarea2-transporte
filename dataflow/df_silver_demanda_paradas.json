{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(AnioFuente = toShort(AnioFuente),",
				"          DemandaId = trim(DemandaId),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = trim(Franja),",
				"          Metodo = upper(trim(Metodo)),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          Descensos = toInteger(Descensos),",
				"          DemandaNoAtendida = toInteger(DemandaNoAtendida),",
				"          FechaServicio = iif(\r",
				"    isDate(FechaServicio, 'dd/MM/yyyy'),\r",
				"    toDate(FechaServicio, 'dd/MM/yyyy'),\r",
				"    toDate(FechaServicio, 'yyyy-MM-dd')\r",
				"),",
				"          RutaHistoricaId = iif(     startsWith(trim(RutaHistoricaId), 'RH-'),     trim(RutaHistoricaId),     concat(         'RH-',         lpad(             regexReplace(trim(RutaHistoricaId), '[^0-9]', ''),             2,             '0'         )     ) )) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(AnioFuente) && !isNull(DemandaId) && !isNull(FechaServicio) && !isNull(RutaHistoricaId) && !isNull(ParadaHistoricaId) && !isNull(Franja) && !isNull(ValidacionesTarjeta) && !isNull(Descensos) && !isNull(DemandaNoAtendida) && !isNull(Metodo) && ValidacionesTarjeta >= 0 && Descensos >= 0 && DemandaNoAtendida >= 0,",
				"     disjoint: false) ~> split1@(demandaValidas, demandaNoValidas)",
				"split1@demandaValidas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}